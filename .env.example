# =====================================================================
# AI-Powered Photo Retrieval Discovery Engine - Environment Config
# =====================================================================

# --- Server & Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
MOCK_DATA_MODE=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/discovery_engine
# SQLite fallback option for local testing if Postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///./discovery_engine.db

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Security & Auth (JWT) ---
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Frontend Settings (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXTAUTH_SECRET=change_this_to_a_secure_random_nextauth_secret
